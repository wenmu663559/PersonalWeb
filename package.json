{
  "name": "form-personal-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node scripts/preview-static.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "cf:dev": "wrangler dev",
    "cf:login": "wrangler login",
    "cf:check": "wrangler deploy --dry-run",
    "cf:migrate": "wrangler d1 migrations apply lijunwen-form-messages --remote",
    "cf:deploy": "wrangler deploy",
    "build": "node scripts/build-static.js",
    "preview:static": "node scripts/preview-static.js",
    "start:legacy": "node server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1",
      "sharp": "^0.35.5"
    }
  }
}
